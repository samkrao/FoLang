// lifecycle=true does not grant customization on its own: the guard requires
// valid generic metadata with an EXPLICIT types=[...] list, so a generic
// annotation carrying only the field leaves the class non-generic for this rule.
@co.dap.generic(lifecycle=true)
_ co.lang.class = {
    id co.lang.int;

    @co.dap.override
    @@init(id co.lang.int) = { this.id = id; }
}
