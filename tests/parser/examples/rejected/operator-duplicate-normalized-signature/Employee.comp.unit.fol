_ co.lang.unit = {
    @co.dap.operator(symbol='+', mode=overload)
    (Employee) first(left Employee, right Employee)->(Employee) = {
        this => left;
    }

    @co.dap.operator(symbol='+', mode=overload)
    second(left Employee, right Employee)->(Employee) = {
        this => left;
    }
