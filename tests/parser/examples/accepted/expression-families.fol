StringIntMap co.type = co.Map(co.string, co.int);
tupleValue := (1, 2, 3);
IntArray co.type = co.int->([]);
arrayValue := IntArray{1, 2, 3,};
mapValue := StringIntMap{ "one": 1, "two": 2, };
objectValue := Employee{ id: 1, name: "Rao", };
groupedValue := (1 + 2) * 3;
rangeValue := 1 ..< 10;
logicValue := 1 < 2 && 3 != 4 || co.const.false;
bitsValue := 1 | 2 ^ 3 & 4;
powerValue := 2 ** 3 ** 2;
callValue := build(value=1, 2);
indexValue := arrayValue[0];
memberValue := objectValue.name;
lambdaValue := arrayValue.map(|x co.int| => x + 1);
comprehensionValue := for (x <- arrayValue).yield(x * 2);
