_ co.lang.class = {
    id co.lang.int;

    @co.dap.operator(symbol='+', mode=overload)
    addInstance(other Staff)->(Staff) = {
        this => other;
    }

    @co.dap.operator(symbol='-', mode=overload)
    @co.dap.static
    subtract(left Staff, right Staff)->(Staff) = {
        this => left;
    }
}
