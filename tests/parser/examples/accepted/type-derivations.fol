Pointer co.type = co.int->(***, region="heap");
Reference co.type = co.int->(&);
RvalueReference co.type = co.int->(&&);
Borrow co.type = co.int->(~);
Address co.type = co.int->(@);
Thunk co.type = co.int->(^);
Slice co.type = co.int->([:]);
Range co.type = co.int->(..);
Array co.type = co.int->([10][,20]);
generic Map(co.string, co.int);
UnionType co.type = co.int | co.string;
FunctionType co.type = (co.int)->(co.string);
