_ co.unit = {
    quantified co.type = forall(T).(T)->(T);

    // `self` and `forall` are contextual-keyword spellings, not hard reserved
    // words, so outside their contextual forms they are ordinary identifiers.
    ordinaryNames(forall co.int, self co.int)->(co.int) = {
        sum := forall + self;
        this => sum;
    }

    localNames()->() = {
        forall := 1;
        self co.int = 2;
        forall = self;
    }

    // An anonymous function may use a generic name owned by its enclosing
    // declaration, but does not introduce its own forall binder.
    @co.dap.generic(types=[{name=T}])
    contextualForms()->() = {
        anonymous := (x T)->(T) { this => x; };
    }
}
