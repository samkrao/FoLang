// The module half: an associated-type binding and a type component, alongside
// ordinary variable and function members.
_ co.module->(signature=EmployeeModule) = {
    Elem co.associatedType = co.int;
    ElemList co.type = co.List(Elem);
    T co.type = co.string;

    counter co.int = 0;

    store(emp Employee)->(Employee) = {
        this => emp;
    }
}
