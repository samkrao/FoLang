// Employee.fol — ordinary package-level type
_ co.struct = {
    Id   co.int;
    Name co.string;
}

// EmployeeModule.fol
_ co.signature = {
    getEmployee(id co.int)->(Employee);
}

// EmployeeModImpl.fol
@co.dap.module(signature=EmployeeModule)
_ co.module->(signature=EmployeeModule, matches=EmployeeModule) = {

    getEmployee(id co.int)->(Employee) = {
        this => Employee{
            Id: 10,
            Name: "Rao"
        };
    }
}

mm EmployeeModule = EmployeeModImpl;
v Employee = mm.getEmployee(10);
