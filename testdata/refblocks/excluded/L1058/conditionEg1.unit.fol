(boolean truth).then({
}).otherwise(boolean truth).then({
}).default({
});

//conditionEg1.unit.fol

_ co.unit = {

    someFun()->()={

        x := co.const.true;

        x.then({

        }).default({

        });
    }

    someOtherFun()->()={

        (co.const.true).then({  //parenthesis mandatory

        }).default({

        });
    }

    someOtherFun1()->()={
        x co.bool =co.const.true;
        (x).then({   // parentheses optional

        }).default({

        });

    }

    someOtherDiffFun1()->()={

        x co.int=10;
        y := 30;

        (x > y).then({     // parentheses around (x > y) are mandatory

        }).otherwise(x < y).then({

        }).default({

        });
    }
}
