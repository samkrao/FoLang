// ProducerConsumerShared.fol
_ co.object->(
    for=[Producer, Consumer]
) = {
    @co.dap.const capacity co.int = 100;
    @co.dap.final configuration QueueConfiguration = loadConfiguration();

    queue Queue;
    queueLock co.lock;

    enqueue(value Item)->() = {
        lock(queueLock) {
            queue.add(value);
        }
    }

    dequeue()->(Item) = {
        lock(queueLock) {
            this => queue.remove();
        }
    }
}
