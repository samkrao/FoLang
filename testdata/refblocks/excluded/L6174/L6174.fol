// someInterface1.fol

_ co.interface = {
    m1( a co.int)->(co.int);
 
}

// SomeInterface2.fol

_ co.interface = {
    m1( a co.int)->(co.int);
 
}

// SomeInterface3.fol

_ co.interface = {
    m1( a co.int)->(co.int);
 
}


// someMixin1.fol

_ co.mixin= {

    m8 (a co.int)->()={}

    m9 (b co.string)->()={}

    @co.dap.virtual
    m10 ()->()={

    }

    @co.dap.abstract
    m11()->();

}

//someTrait1.fol

_ co.trait = {

    m14 (a co.int)->()={}

    m15 (b co.string)->()={}

    @co.dap.virtual
    m10 ()->()={

    }

    @co.dap.abstract
    m11()->();

}

@co.dap.oops(
    interfaces = [
        someInterface1,
        someInterface2,
        someInterface3
    ],

    classes = [
        someClass1,
        someClass2
    ],

    mixins = [
        someMixin1
    ],

    traits = [
        someTrait1
    ]
)

_ co.class = {
    // Interface-specific implementation.
    // The target method is inferred from the attached declaration.
    @co.dap.implement(type = someInterface1)
    m1(a co.int) -> (co.int) = {
        this => a;
    };

    // A second interface-specific slot with the same source name/signature.
    @co.dap.implement(type = someInterface2)
    m1(a co.int) -> (co.int) = {
        this => a + 1;
    };

    // Explicit mapping from someInterface3.m1 to child method m1_3.
    @co.dap.implement(
        type = someInterface3,
        method = m1(co.int)->(co.int)
    )
    m1_3(a co.int) -> (co.int) = {
        this => a + 2;
    };

    // Overrides both matching mandatory virtual slots contributed
    // by someMixin1 and someTrait1.
    @co.dap.override
    m10() -> () = {
    };

    // Separate source-qualified abstract implementations.
    @co.dap.implement(type = someMixin1)
    m11() -> () = {
    };

    @co.dap.implement(type = someTrait1)
    m11() -> () = {
    };

    // Alias/wrapper around automatically composed concrete methods.
    m15t(a co.string) -> () =>>
        this->traits[someTrait1].m15(a);

    m9M(a co.string) -> () = {
        this->mixins[someMixin1].m9(a);
    };
}
