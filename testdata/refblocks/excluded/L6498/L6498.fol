someWork()->() = {
    @co.dap.onEffect(
        effects={
            co.lang.FileNotFound={
                resolutions=[continue]
            }
        }
    )
    readOptionalFile();

    @co.dap.onEffect(
        effects={
            co.lang.FileNotFound={
                resolutions=[propagate]
            }
        }
    )
    readRequiredFile();
}
