// Vector.comp.unit.fol
_ co.unit = {
    distance(
        left  Vector,
        right Vector
    )->(co.float) = {
        ...
    }

    zero()->(Vector) = {
        this => Vector{x: 0.0, y: 0.0};
    }

    (value Vector) magnitude()->(co.float) = {
        this => co.math.sqrt(
            value.x * value.x + value.y * value.y
        );
    }

    (Vector) create(
        x co.float,
        y co.float
    )->(Vector) = {
        this => Vector{x: x, y: y};
    }
}
