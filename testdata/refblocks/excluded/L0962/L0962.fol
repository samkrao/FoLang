// Comma
x co.int = 10, y co.string = "Hello", z co.bool = co.const.true;

// Grouping
(x co.int = 10, y co.string = "Hello", z co.bool = co.const.true);

// Parentheses group expressions; they do not construct tuple values.
IntStringPair co.type = co.Tuple(co.int, co.string);
pair := IntStringPair{x, y};
