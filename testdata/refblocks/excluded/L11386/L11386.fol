@co.dap.generic(
    at=callsite,
    types=[
        {name=U, variance=invariant, bound=Number, inference=param},
        {name=T, variance=invariant, bound=Number}
    ],
    mapping=[
        {U=co.int,   T=co.int},
        {U=co.float, T=co.float}
    ],
    impredicative=false,
    resolution=compiletime
)
add(a U, b U)->(T) = { this => a + b; }
