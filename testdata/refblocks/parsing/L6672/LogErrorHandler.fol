// LogErrorHandler.fol
@co.dap.module(signature=co.core.EffectHandler)
_ co.lang.module->(
    signature=co.core.EffectHandler,
    matches=co.core.EffectHandler
) = {
    @co.dap.private
    writeLog(error co.lang.error)->() = {
        ApplicationLog.write(error);
    }

    handle(error co.lang.error)->() = {
        writeLog(error);
    }
}
