_ co.lang.unit = {
    
    PolyId co.lang.type = forall(U).(U)->(U);

    @co.dap.generic(
        types=[{name=T}],
        aliases=[{name=BoxOfT, type=Box->(T)}]
    )
    box(x T)->(BoxOfT) = {}
    
    someFun(value PolyId)->()={
        result := box(value); // ❌ PolyId cannot instantiate T without explicit opt-in
    }
}
