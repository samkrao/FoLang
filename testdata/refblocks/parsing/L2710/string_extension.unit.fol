// string_extension.unit.fol
_ co.unit = {

    @co.dap.extension(fortype=co.string, what=extends)
    upperCase()->(co.string) = {
        this => this.upper();
    }

    @co.dap.extension(fortype=[co.string], what=overrides)
    equals(str co.string)->(co.bool) = {
        this => this == str;
    }
}
