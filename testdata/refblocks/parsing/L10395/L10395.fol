_ co.lang.object->(for=VectorClient) = {
    @co.dap.final n co.lang.int = readInput();

    invalidIndices()->() = {
        bad Vector(n);           // ❌ immutable, but not known at compile time

        m co.lang.int = 10;
        alsoBad Vector(m);       // ❌ an ordinary variable is not an index
    }
}
