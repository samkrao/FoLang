_ co.lang.unit = {

    @co.dap.generic(
        types=[{name=T,variance=invariant}],
        aliases=[{name=BoxOfT, type=Box->(T)}],
        impredicative=true
    )
    box(x T)->(BoxOfT) = {}

    PolyId co.lang.type = forall(U).(U)->(U);
    
    someFun(value PolyId)->()={
        result := box(value); // ✅ legal because impredicative=true opts in
    }
}
