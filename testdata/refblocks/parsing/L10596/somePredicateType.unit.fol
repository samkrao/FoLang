
_ co.unit={
    someType co.predicateType =
        co.type.where(
            candidate =>
                candidate == co.int ||
                candidate == co.string
        );


    sortableNumberType co.predicateType =
        co.type.where(
            candidate =>
                candidate <: co.number &&    // candidate is subtype of nuumber
                candidate.implements(co.Comparable) &&
                !candidate.isAbstract
        );
}
