// src/component.fol — standalone native library
@co.dap.library(type=native)
_ co.component = {

    @co.ddap.import(package="driver.internal", as="impl")

    Point co.cstruct = {
        x co.int;
        y co.int;
    }

    getOrigin()->(Point) = {
        internalPoint := impl.DriverService.getOrigin();

        this => Point{
            x: internalPoint.x,
            y: internalPoint.y
        };
    }
}
