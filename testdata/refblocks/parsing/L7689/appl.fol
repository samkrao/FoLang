// appl.fol
SubmitParams  co.type = co.List(co.any);
SubmitResults co.type = co.List(co.any);

@co.dap.onEffect(
    co.DatabaseError={
        handlers=[
            DBConnectionCloseHandler,
            LogErrorHandler
        ]
    }
)
co.cpca.submit(
    loadCustomerAsync,
    params=SubmitParams{id},
    results=SubmitResults{customer, error}
);
