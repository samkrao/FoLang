_ co.unit = {

    @co.dap.implementation(
        kind = co.dap.implementationKind.runtime,
        operation = co.runtime.operation.lang.string.length
    )
    (value co.string) length() -> (co.int);

    @co.dap.implementation(
        kind = co.dap.implementationKind.runtime,
        operation = co.runtime.operation.lang.string.concat
    )
    (left co.string) concat(
        right co.string
    ) -> (co.string);
}