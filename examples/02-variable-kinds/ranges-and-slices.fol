// ranges-and-slices.fol — application entry file
// Spec: language-ref.md > Range Declaration, Reference Declaration,
//       Variable Kinds Support
//
// Ranges and slices are supported in every context.

// --- typed range variable -----------------------------------------------
IntRange co.lang.type = co.lang.int->(..);
IntSlice co.lang.type = co.lang.int->([:]);
Int5 co.lang.type = co.lang.int->([5]);
someRange IntRange;

// --- inferred range forms -----------------------------------------------
rangeI := 1 .. 10;      // [1, 10]    include start, include end
rangeS := 0 <.. 5;      // (0, 5]     exclude start, include end
rangeL := 0 ..< 100;    // [0, 100)   include start, exclude end
rangeB := 0 <..< 100;   // (0, 100)   exclude both
rangeE := .. 100;       // open lower bound  (_, 100]
rangeF := 1 ..;         // open upper bound  [1, _)

// float ranges parse cleanly because a floating literal cannot end at a point
floatRange := 1.0 .. 2.5;

// --- iterating a range --------------------------------------------------
(1 .. 5).each(_, value, {
    co.out.println(value);
});

// --- membership in a range ----------------------------------------------
(1 .. 10).contains(7).then({
    co.out.println("7 is in [1, 10]");
}).default({
    co.out.println("out of range");
});

// --- slices -------------------------------------------------------------
someSlice IntSlice;

backing Int5 = [10, 20, 30, 40, 50];
someSlice = backing[1 ..< 4];

someSlice.each(idx, val, {
    co.out.print(idx);
    co.out.print(" -> ");
    co.out.println(val);
});

co.out.println(someRange);
co.out.println(rangeI);
co.out.println(rangeS);
co.out.println(rangeL);
co.out.println(rangeB);
co.out.println(rangeE);
co.out.println(rangeF);
co.out.println(floatRange);
