// memops/References.fol — package source file in package "memops"
// Spec: language-ref.md > Reference Declaration, Pointers for address
//       manipulation
// Grammar: reference-specification, address-type-specification,
//          thunk-type-specification, slice-type-specification

_ co.lang.unit = {
    IntRef co.lang.type = co.lang.int->(&);
    IntLValueRef co.lang.type = co.lang.int->(&&);
    IntHeapRef co.lang.type = co.lang.int->(~);
    IntAddress co.lang.type = co.lang.int->(@);
    IntThunk co.lang.type = co.lang.int->(^);
    IntSlice co.lang.type = co.lang.int->([:]);

    // Every reference-family derivation the reference lists.
    forms()->() = {
        target co.lang.int = 42;

        someRef IntRef = target;
        someLValueRef IntLValueRef = target;
        someHpRef IntHeapRef = target;
        someAddr IntAddress = target;
        someThunk IntThunk;
        someSlice IntSlice;

        co.out.println(someRef);
        co.out.println(someLValueRef);
        co.out.println(someHpRef);
        co.out.println(someAddr);
        co.out.println(someThunk);
        co.out.println(someSlice);
    }

    // An address taken from a plain variable, matching the reference's
    // address-manipulation example.
    addressOf()->() = {
        source  co.lang.int = 10;
        address IntAddress = source;

        co.out.println(address);
    }
}
