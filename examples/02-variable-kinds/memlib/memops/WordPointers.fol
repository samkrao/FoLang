// memops/WordPointers.fol — package source file in package "memops"
// Spec: language-ref.md > Pointers for address manipulation
// Grammar: derivation-attribute-list (repr / sign attributes)
//
// Word-typed derivations describe integer representations of addresses rather
// than pointers to a base type.

_ co.lang.unit = {
    IntPtrWord co.lang.type = co.lang.word->(repr=intptr);
    UIntPtrWord co.lang.type = co.lang.word->(sign=unsigned, repr=uintptr);
    PtrDiffWord co.lang.type = co.lang.word->(repr=ptrdiff);
    USizeWord co.lang.type = co.lang.word->(sign=unsigned, repr=usize);
    ISizeWord co.lang.type = co.lang.word->(repr=isize);
    NullPtrWord co.lang.type = co.lang.void->(repr=nullptr);

    representations()->() = {
        y IntPtrWord;
        z UIntPtrWord;
        p PtrDiffWord;
        n USizeWord;
        m ISizeWord;
        o NullPtrWord;

        co.out.println(y);
        co.out.println(z);
        co.out.println(p);
        co.out.println(n);
        co.out.println(m);
        co.out.println(o);
    }

    wordSize()->(co.lang.int) = {
        this.return 8;
    }
}
