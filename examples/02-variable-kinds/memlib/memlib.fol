// memlib.fol — library surface file
// Spec: language-ref.md > Libraries, Library Kinds > `system` Libraries,
//       System and FFI Surface Example
//
// Pointers, references, addresses, and native code are legal only inside a
// `system` or `ffi` library. This surface declares the library kind; the
// pointer examples live in the internal `memops` package next to it.
//
// A source library is imported with:
//     @co.ddap.import(package="memlib", src-library=true,
//                     expect="system", as="mem")
//
// A system surface exposes cstruct contracts only, transferred by system ABI
// value. Pointers may never cross a public surface.

@co.dap.library(type=native)
_ co.lang.component = {

    @co.ddap.import(package="memops", as="impl")

    // boundary data contract — cstruct, because the kind is `system`
    Point co.lang.cstruct = {
        x co.lang.int32;
        y co.lang.int32;
    }

    // boundary adapter: one internal call, deterministic field conversion,
    // and construction of an allowed surface value
    getOrigin()->(Point) = {
        internalPoint := impl.Pointers.origin();

        this.return Point{
            x: internalPoint.x,
            y: internalPoint.y
        };
    }

    // direct delegation is the simplest adapter form, used when no conversion
    // is required
    wordSize()->(co.lang.int)
        =>> impl.WordPointers.wordSize();
}
