// arrays.fol — application entry file
// Spec: language-ref.md > Array Declaration, Array Declaration with
//       Initialization
// Grammar: array-specification, array-dimension-group
//
// Arrays are a variable kind supported in every context.

// --- shapes -------------------------------------------------------------
Int5 co.lang.type = co.lang.int->([5]);
Int2x3 co.lang.type = co.lang.int->([2,3]);
IntJagged2x3 co.lang.type = co.lang.int->([2][3]);
IntVLA co.lang.type = co.lang.int->([...]);
IntZero co.lang.type = co.lang.int->([0]);
IntZeroDim co.lang.type = co.lang.int->([.]);
Int3 co.lang.type = co.lang.int->([3]);
IntInitArray co.lang.type = co.lang.int->([]);
IntInitMatrix co.lang.type = co.lang.int->([,]);
String2 co.lang.type = co.lang.string->([2]);

someArray       Int5;      // single dimension, fixed length
someDblArray    Int2x3;    // multi dimension
someJaggedArray IntJagged2x3; // jagged: dimension groups chain
someVLArray     IntVLA;    // variable length
someZeroLA      IntZero;   // zero length
someZeroDimA    IntZeroDim; // zero dimension

// --- with initialization ------------------------------------------------
sized      Int3 = [1, 2, 3];
inferred   IntInitArray = [1, 2, 3];        // length from the literal
twoDim     IntInitMatrix = [[1, 2], [3, 4]]; // both dimensions elided
strings    String2 = ["alpha", "beta"];

// --- element access and mutation ----------------------------------------
sized[0] = 10;
sized[2] += 5;
head := sized[0];

// --- iteration: `each` supplies index and value -------------------------
sized.each(idx, val, {
    co.out.print(idx);
    co.out.print(" :: ");
    co.out.println(val);
});

// `_` discards the index — it is legal here because iterator constructs are
// one of the few places a lone underscore is permitted
sized.each(_, val, {
    co.out.println(val);
});

// --- membership ---------------------------------------------------------
needle co.lang.int = 10;
sized.contains(needle).then({
    co.out.println("found");
}).default({
    co.out.println("not found");
});

co.out.println(head);
co.out.println(inferred);
co.out.println(twoDim);
co.out.println(strings);
co.out.println(someArray);
co.out.println(someDblArray);
co.out.println(someJaggedArray);
co.out.println(someVLArray);
co.out.println(someZeroLA);
co.out.println(someZeroDimA);
