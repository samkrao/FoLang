// entry-local-types.fol — application entry file
// Spec: language-ref.md > Type Declarations, Allowed Entry-File Constructs
// Grammar: entry-type-declaration
//
// An entry file may declare non-structural types. Everything declared here is
// private to the entry file: entry-local symbols cannot be imported,
// exported, or referenced by package or library source files.

// --- alias: interchangeable with its base type --------------------------
Age co.type = co.int;

// --- newtype: a distinct type with the same representation --------------
UserId co.newtype = co.int;

// --- opaque type --------------------------------------------------------
// Acts like an alias to its base type inside the declaring scope and like a
// distinct type everywhere else — even against another opaque type built from
// the same base.
Token co.opaquetype = co.string;

// --- ADT alias: a tagged union of existing types -------------------------
Scalar co.type = co.int | co.char;

// --- subtype (covariant) and supertype (contravariant) ------------------
SmallInt co.subtype   = co.int;
AnyInt   co.supertype = co.int;

// --- function type alias ------------------------------------------------
BinaryOp co.type = (co.int, co.int)->(co.int);

// --- dependent-type usage ----------------------------------------------
// An entry file may USE a dependent type and alias it, but it may not declare
// the type-constructor function itself — see 09-types/Vector.fol for that.
Triple co.type = Vector(3);

age    Age    = 30;
userId UserId = 1001;
token  Token  = "abc123";
point  Triple = Triple{1, 2, 3};

co.out.println(age);
co.out.println(userId);
co.out.println(token);
co.out.println(point);

// Forbidden in an entry file: ordinary `let` value bindings, ordinary
// functions, anonymous functions, general closures, classes, structs, enums,
// cstructs, type constructors, generics, macros, templates, units, and any
// other reusable behavioural declaration.
