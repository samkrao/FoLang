// extensions/StringExtension.fol — package source file in package "extensions"
// Spec: language-ref.md > Extensions
//
// An extension adds or replaces behaviour on an existing type. `what=extends`
// adds a new operation; `what=overrides` replaces an existing one.
//
// Extensions are NOT active by default. They are block-scoped and must be
// explicitly activated at the use site:
//
//     @co.ddap.use(from="StringExtension", extensions=[equals, upperCase])
//     k.upperCase();      // ✅ explicitly activated

_ co.unit = {

    @co.dap.extension(fortype=co.string, what=extends)
    upperCase()->(co.string) = {
        this => this.upper();
    }

    @co.dap.extension(fortype=[co.string], what=overrides)
    equals(str co.string)->(co.bool) = {
        this => this == str;
    }
}
