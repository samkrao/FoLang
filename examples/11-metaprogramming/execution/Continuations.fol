// execution/Continuations.fol — package source file in package "execution"
// Spec: language-ref.md > Execution Models and Control Abstractions
//
// @project.continuation enables continuation support. An annotated function may
// use co.cpca constructs to suspend, yield control or a value, preserve its
// execution state, and later resume from the suspension point.
//
// Continuations, defer, lazy evaluation, and thunks belong to `advanced`
// libraries — a `system` library forbids them.

_ co.unit = {
    IntThunk co.type = co.int->(^);

    @project.continuation
    counter(limit co.int)->(co.int) = {
        current co.int = 0;

        (current < limit).loop({
            co.cpca.yield(current);
            current += 1;
        });

        this => current;
    }

    @project.generator
    naturals()->(co.int) = {
        n co.int = 0;

        (co.const.true).loop({
            co.cpca.yield(n);
            n += 1;
        });
    }

    drive(limit co.int)->(co.int) = {
        // a lazy binding: the right-hand side is not evaluated until demanded
        @co.dap.lazy
        deferred = counter(limit);

        // a thunk holds an unevaluated computation
        pending IntThunk;

        // @co.dap.defer schedules work to run when the scope unwinds
        @co.dap.defer
        co.out.println("done");

        this => deferred;
    }
}
