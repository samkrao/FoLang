// BinaryOp.fol — package source file
// Spec: language-ref.md > Function Delegates, Syntax 2 — Named type alias
// Grammar: delegate-declaration, function-type
//
// A delegate names a CALL SHAPE — a parameter type list and a return type
// clause. It is a type-level declaration, so parameter names do not appear.
//
// The related spellings:
//
//     BinaryOp co.delegate = (co.int, co.int)->(co.int);
//     BinaryOp co.type     = (co.int, co.int)->(co.int);
//     Handler  co.function = (a co.int)->(co.int) = { ... }
//
// The first two are types; the third is a concrete function value.

@co.dap.delegate
_ co.unit = {
BinaryOp co.delegate = (co.int, co.int)->(co.int, co.int);
}
