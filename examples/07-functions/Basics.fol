// Basics.fol — package source file
// Spec: language-ref.md > Functions > Normal, Default Parameters, Variadic
//       Functions, Optional Parameters, Named Parameters, Named Returns
// Grammar: function-declaration, parameter, return-type-clause

_ co.unit = {
    OutIntRef co.type = co.int->(&, meta={type=out});

    // --- normal, with multiple return values -----------------------------
    // A FoLang function may return more than one value.
    fun1(k co.int, b co.char)->(co.int, co.char) = {
        this => k + 1, b;
    }

    // --- no return values -------------------------------------------------
    log(message co.string)->() = {
        co.out.println(message);
    }

    // --- default parameters -----------------------------------------------
    withDefaults(k co.int, b co.int = 10)->(co.int) = {
        this => k + b;
    }

    // --- variadic ---------------------------------------------------------
    // A curried function may not be variadic, and vice versa.
    variadic(k co.int, ...rest co.char)->(co.int) = {
        this => k;
    }

    // --- optional parameters ----------------------------------------------
    // `k?` marks the parameter optional; `.omitted` reports whether the caller
    // supplied it.
    optional(k? co.int)->(co.int) = {
        result co.int = 0;

        (k.omitted).then({
            result = 0;
        }).default({
            result = k;
        });

        this => result;
    }

    // --- named parameters -------------------------------------------------
    // `~k` must be passed by name at the call site.
    named(~k co.int, ~label co.string)->(co.string) = {
        this => label;
    }

    // --- multiple returns -------------------------------------------------
    // Result clauses contain types only. A parameter may still be marked as an
    // out parameter through its derivation metadata.
    doManyThings(
        a co.int,
        b OutIntRef
    )->(co.int, co.string) = {
        b = a * 2;
        this => a, "";
    }

    // --- call sites -------------------------------------------------------
    demo()->() = {
        // Receiving several results needs care. `multiple-assignment-statement`
        // pairs N targets with N expressions in an `expression-list`, and `:=`
        // is a single-declarator definition operator, so neither of these
        // destructures one multi-result call:
        //
        //     value, letter := fun1(1, 'A');   // ❌ := takes one declarator
        //     value, letter = fun1(1, 'A');    // ❌ 2 targets, 1 value
        //
        // Multiple assignment is for pairing up independent expressions:
        first  co.int;
        second co.int;
        first, second = 1, 2;
        first, second = second, first;

        // An OUT parameter is the way to hand a second result back — see
        // doManyThings above, whose `b` carries meta={type=out}.
        produced co.int;
        primary  co.int;
        primary = doManyThings(21, produced);

        log("called fun1");

        co.out.println(first);
        co.out.println(second);
        co.out.println(primary);
        co.out.println(produced);
        co.out.println(withDefaults(5));
        co.out.println(withDefaults(5, 20));
        co.out.println(variadic(1, 'a', 'b', 'c'));
        co.out.println(optional());
        co.out.println(optional(7));
        co.out.println(named(k=1, label="tagged"));
    }
}
