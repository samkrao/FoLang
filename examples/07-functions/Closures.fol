// Closures.fol — package source file
// Spec: language-ref.md > Closure, Functions Taking and Returning Functions

_ co.unit = {
    IntUnary co.type = (co.int)->(co.int);

    // A closure captures state from its declaration site and keeps it alive
    // across calls. The returned function shares `sum` with the closure that
    // produced it.
    adder()->(IntUnary) = {
        sum co.int = 0;

        closure := (x co.int)->(co.int) {
            sum += x;
            this => sum;
        };
        this => closure;
    }

    // A parameterised closure factory.
    multiplier(factor co.int)->(IntUnary) = {
        closure := (x co.int)->(co.int) {
            this => x * factor;
        };
        this => closure;
    }

    demo()->() = {
        next := adder();
        co.out.println(next(1));   // 1
        co.out.println(next(2));   // 3
        co.out.println(next(3));   // 6

        triple := multiplier(3);
        co.out.println(triple(7));

        // Closures are always lexically scoped: names resolve at the
        // declaration site, never from the caller's scope.
    }
}
