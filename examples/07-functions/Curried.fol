// Curried.fol — package source file
// Spec: language-ref.md > Curried, Function Objects and Function Types
// Grammar: function-declaration with repeated parameter-lists and
//          anonymous-function-expression

_ co.unit = {

    // --- curried function: one parameter list per stage --------------------
    add(first co.int)(second co.int)->(co.int) = {
        this => first + second;
    }

    scale(factor co.int)(value co.int)(bias co.int)->(co.int) = {
        this => factor * value + bias;
    }

    demo()->() = {
        // A named local function uses the same curried declaration form as a
        // package function.
        curry(factor co.int)(val co.int)->(co.int) = {
            this => factor * val;
        }

        // An anonymous function value is introduced by an ordinary binding.
        closure := (factor co.int, x co.int)->(co.int) {
            this => x * factor;
        };

        co.out.println(add(1)(2));
        co.out.println(scale(2)(3)(4));
        co.out.println(curry(3)(4));
        co.out.println(closure(5, 6));
    }

    // A curried function cannot be variadic, cannot be overloaded, cannot be
    // used as a callback, and cannot take part in execution models and control
    // abstractions.
}
