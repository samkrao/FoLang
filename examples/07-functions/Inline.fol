// Inline.fol — package source file
// Spec: language-ref.md > Functions in detail > Inline

_ co.unit = {

    @co.dap.inline
    add(a co.int, b co.int)->(co.int) = {
        this => a + b;
    }

    @co.dap.inline
    max(a co.int, b co.int)->(co.int) = {
        this => (a > b).return(a).otherwise.return(b);
    }

    // The `=` before a block body is optional (DECISION-FUN-001), so this is
    // the same declaration form written without it.
    @co.dap.inline
    abs(value co.int)->(co.int) = {
        this => (value < 0).return(0 - value).otherwise.return(value);
    }
}
