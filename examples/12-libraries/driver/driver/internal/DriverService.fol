// driver/internal/DriverService.fol — internal package source file
// Spec: language-ref.md > Library Kinds > `system` Libraries, Native Functions
//
// Pointers, addresses, and native code are legal here because this is the
// internal side of a `system` library. Units containing free functions,
// structs and cstructs, type aliases, and basic threading primitives are also
// allowed internally.

_ co.lang.unit = {
    UIntPtrWord co.lang.type = co.lang.word->(sign=unsigned, repr=uintptr);
    Int32Pointer co.lang.type = co.lang.int32->(*);

    getOrigin()->(Origin) = {
        base UIntPtrWord;
        slot Int32Pointer;

        this.return Origin{ x: 0, y: 0 };
    }

    @co.dap.native
    readRegister(address UIntPtrWord)->(co.lang.int32) = {
        this.return co.native.inline("return *(int32_t*)address;");
    }
}
