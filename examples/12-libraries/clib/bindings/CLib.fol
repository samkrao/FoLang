// bindings/CLib.fol — internal package source file in package "bindings"
// Spec: language-ref.md > Library Kinds > `ffi` Libraries,
//       Forward / Extern Declarations
//
// Internally an FFI library may use native and extern declarations, pointers,
// references, addresses, C ABI types, cstructs, restricted implementation
// structs, units of free functions, and calling-convention and symbol-linkage
// metadata.
//
// Internally forbidden: classes, modules, interfaces, signatures, overloading
// and overriding, new operator definitions, generics, templates, macros,
// reflection, dynamic runtime, dependent types, type classes, closures,
// currying, and advanced concurrency machinery.

_ co.lang.unit = {
    ByteBuffer co.lang.type = co.lang.byte->([...]);
    BytePointer co.lang.type = co.lang.byte->(*);
    USizeWord co.lang.type = co.lang.word->(sign=unsigned, repr=usize);

    // extern: defined in another linkage unit
    @co.dap.declare(extern)
    crc32(data ByteBuffer, length co.lang.int32)->(co.lang.uint32);

    @co.dap.native
    memcopy(
        dst BytePointer,
        src BytePointer,
        n USizeWord
    )->() = {
        co.native.inline("memcpy(dst, src, n);");
    }
}
