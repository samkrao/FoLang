// assignment.fol — application entry file
// Spec: language-ref.md > Expressions > Assignment, Compound Assignment,
//       Multiple Assignment
// Grammar: assignment-expression, multiple-assignment-statement

// --- simple assignment --------------------------------------------------
// The target binding is determined first, then the right-hand side is
// evaluated, then the value is stored.
result co.int;
result = 10 + 20;

// --- indexed assignment -------------------------------------------------
Int5 co.type = co.int->([5]);
values Int5 = Int5{1, 2, 3, 4, 5};
values[0] = 99;

// --- compound assignment ------------------------------------------------
// The target is evaluated exactly once: `values` and the index expression
// are not re-evaluated by the += expansion.
values[1] += 100;

// --- multiple assignment ------------------------------------------------
// Every right-hand side is evaluated completely, left to right, before any
// target receives its new value.
first  co.int;
second co.int;
first, second = 1, 2;

// which makes an exchange possible without a temporary
first, second = second, first;

// --- assignment is an expression and is right-associative ---------------
x co.int;
y co.int;
z co.int;
x = y = z = 0;

co.out.println(result);
co.out.println(values[0]);
co.out.println(values[1]);
co.out.println(first);
co.out.println(second);
co.out.println(x);
