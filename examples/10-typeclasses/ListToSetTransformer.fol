// ListToSetTransformer.fol — package source file
// Spec: language-ref.md > Type Classes > Transformer
//
// A structure with more than one type-constructor parameter binds them with
// `types=[...]` rather than `type=`.

_ co.lang.instance->(for=Transformer, types=[List, Set]) = {

    map(value List(A), f Mapper)->(Set(B)) = {
        result := Set(B){};

        value.each(_, item, {
            result.insert(f(item));
        });

        this.return result;
    }
}
