// IntMonoid.fol — package source file
// Spec: language-ref.md > Type Classes > Monoid
//
// An instance may be defined for a BUILT-IN type, not only for user types.

_ co.lang.instance->(for=Monoid, type=co.lang.int) = {

    empty()->(co.lang.int) = {
        this.return 0;
    }

    combine(a co.lang.int, b co.lang.int)->(co.lang.int) = {
        this.return a + b;
    }
}
