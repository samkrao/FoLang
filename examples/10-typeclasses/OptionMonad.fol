// OptionMonad.fol — package source file
// Spec: language-ref.md > Type Classes > Monad

_ co.lang.instance->(for=Monad, type=Option) = {

    pure(x A)->(InputContainer) = {
        this => Some(x);
    }

    flatMap(fa InputContainer, f FlatMapper)->(ResultContainer) = {
        this => fa.match()
            .case(Some(x) => f(x))
            .default(None());
    }
}
