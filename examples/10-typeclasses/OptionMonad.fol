// OptionMonad.fol — package source file
// Spec: language-ref.md > Type Classes > Monad

_ co.lang.instance->(for=Monad, type=Option) = {

    pure(x A)->(Option(A)) = {
        this.return Some(x);
    }

    flatMap(fa Option(A), f OptionMapper)->(Option(B)) = {
        this.return fa.match()
            .case(Some(x) => f(x))
            .default(None());
    }
}
