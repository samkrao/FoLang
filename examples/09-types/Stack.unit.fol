// Stack.fol — package source file
// Spec: language-ref.md > Stack — Value and Type Parameter
//
// A type constructor may mix VALUE and TYPE parameters:
//
//     s Stack(10, co.int)    = ...;   at most 10 ints
//     t Stack(5,  co.string) = ...;   at most 5 strings

_ co.unit = {
Stack(n co.int, T co.type)->(co.dependentType) =
    T->([n]);
}
