// type-declarations.fol — application entry file
// Spec: language-ref.md > Type Declarations, More About Type, Builtin Kinds
// Grammar: type-declaration, type-declaration-kind
//
// Every declaration below binds a type expression, so each one ends with a
// semicolon rather than a body brace.

// --- alias --------------------------------------------------------------
// Interchangeable with the base type.
Meters co.type = co.int;

// alias with the explicit alias kind
Feet co.typealias = co.int;

// --- newtype ------------------------------------------------------------
// Same representation, distinct type. A Meters value is not a UserId.
UserId co.newtype = co.int;

// --- opaque type --------------------------------------------------------
// Behaves like an alias to its base type where it is declared, and like a
// distinct type everywhere else — including against another opaque type built
// from the same base.
Token   co.opaquetype = co.string;
Session co.opaquetype = co.string;   // distinct from Token

// --- ADT alias (tagged union of existing types) --------------------------
Scalar co.type = co.int | co.char;

// --- subtype: covariant --------------------------------------------------
SmallInt co.subtype = co.int;

// --- supertype: contravariant --------------------------------------------
AnyInt co.supertype = co.int;

// `co.associatedtype` and `co.refinementType` are also
// type-declaration kinds, but the entry file's allowed set covers only
// aliases, newtypes, opaque types, dependent-type aliases and usages,
// subtypes, and supertypes. Those two therefore live in package source files —
// see Element.fol and NonZero.fol.

// --- function type alias --------------------------------------------------
BinaryOp co.type = (co.int, co.int)->(co.int);

// --- polymorphic type alias (Rank-2) --------------------------------------
PolyId co.type = forall(T).(T)->(T);

// --- uses -----------------------------------------------------------------
distance Meters   = 100;
height   Feet     = 6;
id       UserId   = 1001;
token    Token    = "abc";
digit    Scalar   = 7;
small    SmallInt = 3;
wide     AnyInt   = 300;

co.out.println(distance);
co.out.println(height);
co.out.println(id);
co.out.println(token);
co.out.println(digit);
co.out.println(small);
co.out.println(wide);

// The three declaration shapes worth keeping straight:
//
//     Name(T) co.data = variants;      concrete ADT constructor,
//                                           right-hand side mandatory
//     Name(T) co.type;                 abstract requirement, signatures
//                                           only
//     Name(T) co.type = Other(T);      concrete alias or component
//                                           binding
