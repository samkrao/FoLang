// loops.fol — application entry file
// Spec: language-ref.md > Loops
// Grammar: informative-loop-chain (section 11a)
//
// A loop is the same chain shape as a condition with `.loop` in place of
// `.then`: the block repeats while the guarding expression stays true.

counter co.lang.int = 0;

// --- simple loop --------------------------------------------------------
(counter < 5).loop({
    co.out.println(counter);
    counter += 1;
});

// --- another independent loop ------------------------------------------
items co.lang.int = 0;

(items > 0).loop({
    items -= 1;
});

// --- loop conditions remain ordinary expressions -----------------------
mode co.lang.int = 2;
ticks co.lang.int = 0;

(mode == 1).loop({
    ticks += 1;
    mode = 0;
});
(mode == 2).loop({
    ticks += 2;
    mode = 0;
});

// --- selections and loops are separate canonical chains -----------------
budget co.lang.int = 10;

(budget > 100).then({
    co.out.println("plenty");
}).default({
    co.out.println("limited");
});
(budget > 0).loop({
    budget -= 3;
});
(budget == 0).then({
    co.out.println("exhausted");
});

co.out.println(counter);
co.out.println(ticks);
co.out.println(budget);
