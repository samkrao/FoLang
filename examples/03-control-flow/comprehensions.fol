// comprehensions.fol — application entry file
// Spec: language-ref.md > Comprehensions *(planned)*
// Grammar: comprehension-expression, comprehension-binding, lambda-expression
//
// PLANNED FEATURE. The reference marks comprehensions as planned; the grammar
// already encodes their shape, so the forms below are the intended spelling.
//
// Within an iteration: source expressions are evaluated in declaration order,
// filters run before result expressions, and a result is produced only when
// its filters succeed. Iterations are never made concurrent implicitly.

// --- pipeline form: lambdas as collection callbacks ---------------------
// `|x| => ...` is allowed only as an inline callback to a collection
// operation such as map, filter, reduce, forEach, sortBy, or groupBy.
k := (1 .. 10).filter(|x| => x % 2 == 0).map(|x| => x * x);

nums  := co.core.list.of(1, 2, 3, 4);
sq    := nums.map(|x| => x * x);
long  := nums.filter(|s| => s > 2);
total := nums.reduce(|acc, e| => acc + e, 0);

// --- for/yield form -----------------------------------------------------
// The comprehension takes the shape of its source: a list yields a list, a
// set yields a set, an option yields an option, a future yields a future.
doubledList := for (x <- co.core.list.of(1, 2, 3)).yield(x * 2);
doubledSet  := for (x <- co.core.set.of(1, 2, 3)).yield(x * 2);
doubledOpt  := for (x <- Some(5)).yield(x * 2);

// --- destructuring a map in the binding pattern -------------------------
ages  := { "A": 30, "B": 40, "c": 66, "e": 88 };
upper := for ((name, age) <- ages).yield(name.toUpperCase(), age);

co.out.println(k);
co.out.println(sq);
co.out.println(long);
co.out.println(total);
co.out.println(doubledList);
co.out.println(doubledSet);
co.out.println(doubledOpt);
co.out.println(upper);
