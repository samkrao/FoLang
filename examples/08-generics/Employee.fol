// Employee.fol — package source file
// Spec: language-ref.md > Generic Types, The @@new and @@init Methods
//
// A generic class. Normally a caller only invokes `init`, which internally
// calls `new`. Generics are the special case where both steps are visible:
//
//     a := Employee.new(co.int, co.string);
//     b := a.init(1, "Rao");
//
// or chained:
//
//     c := Employee.new(co.int, co.string).init(1, "Rao");
//
// @@new returns a co.uninit value; @@init turns it into a live object.
// @@new is provided by default — override it only to change allocation.

@co.dap.generic(types=[{name=T}, {name=R}], lifecycle=true)
_ co.class = {

    id   T;
    name R;

    @co.dap.private
    @@new()->(co.uninit) = {
        this => co.const.none;
    }

    @co.dap.public
    @@new(a co.typevalue, b co.typevalue)->(co.uninit) = {
        // Manual type aliasing. @co.dap.generic normally does this for you;
        // override @@new only when custom allocation logic is required.
        T co.type = a;
        R co.type = b;

        // `self` is allowed only in class methods
        self.parent.new();

        this => co.uninit.instance(Employee, self);
    }

    @co.dap.override
    @co.dap.constructor(access=private)
    @@init() = {}

    @co.dap.override
    @co.dap.constructor(access=public)
    @@init(id T, name R) = {
        this.id = 0;
        this.id   = id;
        this.name = name;
    }

    getEmployee(id T)->(Employee) = {
        this => this;
    }
}
