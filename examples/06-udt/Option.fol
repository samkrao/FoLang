// Option.fol — package source file
// Spec: language-ref.md > Connects to Type Constructor in Spec, More About Type
// Grammar: data-declaration, data-variant
//
//     Name(T) co.data = variants;   concrete ADT type constructor,
//                                        right-hand side mandatory
//     Name(T) co.type;              abstract requirement, signatures only
//     Name(T) co.type = Other(T);   concrete alias or component binding
//
// A data declaration binds an expression, so it ends with a semicolon rather
// than a body brace.
//
// @project.hokrt marks it as a higher-order kind runtime type: Option takes a
// TYPE and returns an ADT type, the type-operator axis of the lambda cube.

_ co.enum = {
    Some,
    None
}
