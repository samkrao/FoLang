// Payload.fol — package source file
// Spec: language-ref.md > Union Declaration, Unions
//
// A co.union is an UNTAGGED ADT: the members share storage and the
// program is responsible for knowing which one is live.
//
// For a TAGGED alternative see Option.fol (co.data) or an ADT type alias
// such as `Scalar co.type = co.int | co.char;`.

_ co.union = {
    intValue   co.int;
    floatValue co.float;
    strValue   co.string;
}
