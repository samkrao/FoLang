  "design_assertions": [
    {
      "id": "NEST-PRIMARY-001",
      "description": "Independent named type/container declarations enter through primary-declaration and are not block statements.",
      "passed": true,
      "evidence": {
        "primary-declaration": "struct-declaration | cstruct-declaration | enum-declaration | union-declaration | data-declaration | class-declaration | interface-declaration | signature-declaration | module-declaration | unit-declaration | type-declaration | object-declaration | instance-declaration | matcher-instance-declaration | function-object-declaration | delegate-declaration | named-block-declaration | annotated-contract-declaration | annotated-function-primary | type-constructor-primary | forward-type-declaration | general-kind-declaration | package-alias-declaration",
        "statement": "variable-declaration | inferred-variable-declaration | grouped-variable-declaration | let-value-declaration | local-function-declaration | closure-declaration | multiple-assignment-statement | return-statement | expression-statement | labeled-block | block-statement | empty-statement"
      }
    },
    {
      "id": "NEST-LOCAL-001",
      "description": "The named local-function exception is represented by local-function-declaration in statement.",
      "passed": true,
      "evidence": {
        "local-function-declaration": "annotations, function-name, parameter-list, { parameter-list }, return-type-clause, function-definition"
      }
    },
    {
      "id": "NEST-LOCAL-002",
      "description": "Local functions cannot be parsed as forward declarations because a block body is mandatory.",
      "passed": true,
      "evidence": {
        "local-function-declaration": "annotations, function-name, parameter-list, { parameter-list }, return-type-clause, function-definition"
      }
    },
    {
      "id": "NEST-ANON-001",
      "description": "Anonymous function, lambda, anonymous class and block forms are expressions.",
      "passed": true,
      "evidence": {
        "primary-expression": "literal | special-binding | \"this\" | \"self\" | qualified-name | wildcard | grouped-expression | tuple-expression | array-literal | map-literal | object-construction | anonymous-class-expression | block | anonymous-function-expression | lambda-expression | let-expression | comprehension-expression"
      }
    },
    {
      "id": "NEST-ANON-002",
      "description": "Anonymous class expressions carry no declaration-name.",
      "passed": true,
      "evidence": {
        "anonymous-class-expression": "\"co.lang.class\", \"{\", { class-member }, \"}\""
      }
    },
    {
      "id": "NEST-FORALL-001",
      "description": "forall is an anonymous type expression with a mandatory dot and is reachable through type-expression.",
      "passed": true,
      "evidence": {
        "type-expression": "forall-type | union-type-expression",
        "forall-type": "\"forall\", \"(\", type-parameter-list, \")\", \".\", type-expression"
      }
    },
    {
      "id": "PACKAGE-FUNCTION-001",
      "description": "Ordinary function-declaration is not a direct package primary; annotated-function-primary is the qualified envelope.",
      "passed": true,
      "evidence": {
        "primary-declaration": "struct-declaration | cstruct-declaration | enum-declaration | union-declaration | data-declaration | class-declaration | interface-declaration | signature-declaration | module-declaration | unit-declaration | type-declaration | object-declaration | instance-declaration | matcher-instance-declaration | function-object-declaration | delegate-declaration | named-block-declaration | annotated-contract-declaration | annotated-function-primary | type-constructor-primary | forward-type-declaration | general-kind-declaration | package-alias-declaration"
      }
    },
    {
      "id": "SCOPE-LOCAL-001",
      "description": "The grammar records declaration-site lexical scope for ordinary local functions.",
      "passed": true
    },
    {
      "id": "SCOPE-INNER-001",
      "description": "The grammar records @co.dap.inner call-site lexical-context resolution without creating physical nesting.",
      "passed": true
    },
    {
      "id": "TERM-OBJECT-001",
      "description": "Object construction is an expression and does not use body-close.",
      "passed": true,
      "evidence": {
        "object-construction": "type-postfix-expression, \"{\", [ object-field-initializer, { \",\", object-field-initializer }, [ \",\" ] ], \"}\""
      }
    },
    {
      "id": "TERM-PATTERN-001",
      "description": "Pattern block bodies are body-terminated and expression results are semicolon-terminated.",
      "passed": true,
      "evidence": {
        "pattern-result": "block, body-closure-guard | non-block-expression, statement-end"
      }
    },
    {
      "id": "TERM-FUNCTION-KIND-001",
      "description": "Direct anonymous function bindings in co.lang.function use body termination; other expressions use statement-end.",
      "passed": true,
      "evidence": {
        "function-object-binding": "anonymous-function-expression, body-closure-guard | non-anonymous-function-expression, statement-end"
      }
    },
    {
      "id": "TERM-UDT-001",
      "description": "Named UDT bodies use body-close.",
      "passed": true
    },
    {
      "id": "DIR-001",
      "description": "Built-in directives are self-delimiting and do not use statement-end.",
      "passed": true
    },
    {
      "id": "ENUM-001",
      "description": "Enum variants use comma separators and the enum body uses body-close.",
      "passed": true
    },
    {
      "id": "LEX-ID-001",
      "description": "Identifiers begin with ASCII letters and use a trailing underscore guard.",
      "passed": true
    },
    {
      "id": "LIT-SEP-001",
      "description": "Numeric digit separators are absent.",
      "passed": true
    },
    {
      "id": "LIT-CONST-001",
      "description": "FoLang boolean and none literal forms are retained.",
      "passed": true
    },
    {
      "id": "DEPENDENT-INDEX-001",
      "description": "Dependent type arguments and array dimensions share the restricted dependent-index production.",
      "passed": true,
      "evidence": {
        "type-or-value-argument": "type-expression | dependent-index",
        "array-dimension": "\"...\" | \".\" | dependent-index"
      }
    },
    {
      "id": "PLANNED-001",
      "description": "Package alias and comprehension productions remain in the complete grammar.",
      "passed": true
    }
  ],
