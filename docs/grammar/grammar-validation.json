  "validation_scope": {
    "kind": "static-ebnf-and-decision-conformance",
    "includes": [
      "production extraction",
      "duplicate detection",
      "undefined reference detection",
      "delimiter balance",
      "root reachability classification",
      "required production-shape assertions"
    ],
    "excludes": [
      "execution of the FoLang parser",
      "semantic type checking",
      "runtime behavior"
    ]
  },
  "termination_conformance_examples": {
    "accepted": [
      {
        "source": "emp := Employee{ id: 1, name: \"Rao\" };",
        "reason": "object-construction is an expression inside a semicolon-terminated declaration"
      },
      {
        "source": "classify(n) => { this.return \"positive\"; }",
        "reason": "direct function-pattern block is a body and ends at }"
      },
      {
        "source": "someFArg co.lang.function = (a co.lang.int, b co.lang.int)->(co.lang.int) = { this.return a + b; }",
        "reason": "direct anonymous function is the inline function-kind body and ends at }"
      },
      {
        "source": "Employee co.lang.struct = { id co.lang.int; name co.lang.string; }",
        "reason": "struct body ends at }"
      },
      {
        "source": "cfg := { \"a\": 1, \"b\": 2 };",
        "reason": "map literal is a braced expression and the declaration still needs ;"
      }
    ],
    "rejected": [
      {
        "source": "emp := Employee{ id: 1, name: \"Rao\" }",
        "reason": "missing statement semicolon after object-construction expression"
      },
      {
        "source": "classify(n) => { this.return \"positive\"; };",
        "reason": "semicolon is forbidden immediately after a direct function-pattern body"
      },
      {
        "source": "someFArg co.lang.function = (a co.lang.int)->(co.lang.int) = { this.return a; };",
        "reason": "semicolon is forbidden immediately after the direct inline function body"
      },
      {
        "source": "Employee co.lang.struct = { id co.lang.int; };",
        "reason": "semicolon is forbidden immediately after the UDT body"
      },
      {
        "source": "@co.ddap.alias(co.out, as=\"out\");",
        "reason": "built-in directives are self-delimiting and do not accept a trailing semicolon"
      }
    ]
  }
