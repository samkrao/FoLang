  "design_assertions": [
    {
      "id": "TERM-OBJECT-001",
      "description": "Object construction is an expression and does not use body-close.",
      "passed": true
    },
    {
      "id": "TERM-OBJECT-002",
      "description": "Inferred variable declarations require statement-end after an object-construction initializer.",
      "passed": true
    },
    {
      "id": "TERM-PATTERN-001",
      "description": "Direct pattern block is body-terminated; expression result is semicolon-terminated.",
      "passed": true
    },
    {
      "id": "TERM-FUNCTION-KIND-001",
      "description": "Direct anonymous function in co.lang.function binding is body-terminated.",
      "passed": true
    },
    {
      "id": "TERM-FUNCTION-KIND-002",
      "description": "Other co.lang.function bindings are expression statements requiring semicolon.",
      "passed": true
    },
    {
      "id": "TERM-UDT-001",
      "description": "Named UDT/container bodies close through body-close.",
      "passed": true
    },
    {
      "id": "TERM-BODY-001",
      "description": "body-close rejects an immediate semicolon.",
      "passed": true
    },
    {
      "id": "TERM-BLOCK-001",
      "description": "A direct block statement is separated from expression-statement.",
      "passed": true
    },
    {
      "id": "DIR-001",
      "description": "Built-in directives are self-delimiting without statement-end.",
      "passed": true
    },
    {
      "id": "ENUM-001",
      "description": "Enum variants use comma separators and body-close.",
      "passed": true
    },
    {
      "id": "LEX-ID-001",
      "description": "Identifiers begin with ASCII letters and forbid leading/trailing/consecutive underscore.",
      "passed": true
    },
    {
      "id": "LIT-SEP-001",
      "description": "Numeric digit separators are absent.",
      "passed": true
    },
    {
      "id": "LIT-CONST-001",
      "description": "FoLang boolean and none literal forms are retained.",
      "passed": true
    },
    {
      "id": "PLANNED-001",
      "description": "Package alias and comprehension productions are retained.",
      "passed": true
    }
  ],
