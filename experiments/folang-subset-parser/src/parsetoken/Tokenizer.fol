_ co.class = {
    source co.string;
    position co.int;
    line co.int;
    column co.int;
    tokens TokenList;

    tokenize()->(TokenList) = {
        (atEnd() == co.const.false).loop({ scanToken(); });
        tokens.add(Token{kind: TokenKind.EndOfFile, text: "", line: line, column: column});
        this => tokens;
    }

    scanToken()->() = {
        startLine := line;
        startColumn := column;
        character := advance();

        (isWhitespace(character)).then({ this ^=>; });
        (character == '\n').then({
            line = line + 1;
            column = 1;
            this ^=>;
        });
        (character == '/' && peek() == '/').then({
            skipLineComment();
            this ^=>;
        });
        (isIdentifierStart(character)).then({
            scanIdentifier(character, startLine, startColumn);
            this ^=>;
        });
        (isDigit(character)).then({
            scanInteger(character, startLine, startColumn);
            this ^=>;
        });
        (character == '"').then({
            scanString(startLine, startColumn);
            this ^=>;
        });

        character.match
            .case('@' => scanAnnotation(startLine, startColumn))
            .case('(' => add(TokenKind.OpenParen, "(", startLine, startColumn))
            .case(')' => add(TokenKind.CloseParen, ")", startLine, startColumn))
            .case('{' => add(TokenKind.OpenBrace, "{", startLine, startColumn))
            .case('}' => add(TokenKind.CloseBrace, "}", startLine, startColumn))
            .case('[' => add(TokenKind.OpenBracket, "[", startLine, startColumn))
            .case(']' => add(TokenKind.CloseBracket, "]", startLine, startColumn))
            .case(',' => add(TokenKind.Comma, ",", startLine, startColumn))
            .case('.' => add(TokenKind.Dot, ".", startLine, startColumn))
            .case(';' => add(TokenKind.Semicolon, ";", startLine, startColumn))
            .case(':' => scanColon(startLine, startColumn))
            .case('=' => scanEquals(startLine, startColumn))
            .case('-' => scanMinus(startLine, startColumn))
            .case('^' => scanCaret(startLine, startColumn))
            .default(scanOperator(character, startLine, startColumn));
    }

    scanIdentifier(first co.char, startLine co.int, startColumn co.int)->() = {
        text := first.toString();
        (isIdentifierPart(peek())).loop({ text = text + advance().toString(); });

        // Qualified co.lang names are one token in this prototype. A normal
        // member dot remains a separate postfix token.
        (peek() == '.' && isQualifiedPrefix(text)).loop({
            text = text + advance().toString();
            (isIdentifierPart(peek())).loop({ text = text + advance().toString(); });
        });

        kind := TokenKind.Identifier;
        (isBuiltInKind(text)).then({ kind = TokenKind.BuiltInKind; });
        add(kind, text, startLine, startColumn);
    }

    scanAnnotation(startLine co.int, startColumn co.int)->() = {
        text := "@";
        (isIdentifierPart(peek()) || peek() == '.').loop({
            text = text + advance().toString();
        });
        add(TokenKind.Annotation, text, startLine, startColumn);
    }

    scanInteger(first co.char, startLine co.int, startColumn co.int)->() = {
        text := first.toString();
        (isDigit(peek())).loop({ text = text + advance().toString(); });
        add(TokenKind.Integer, text, startLine, startColumn);
    }

    scanString(startLine co.int, startColumn co.int)->() = {
        text := "";
        (atEnd() == co.const.false && peek() != '"').loop({
            text = text + advance().toString();
        });
        (atEnd()).then({
            co.out.println("tokenize error: unterminated string");
            this ^=>;
        });
        advance();
        add(TokenKind.String, text, startLine, startColumn);
    }

    scanColon(startLine co.int, startColumn co.int)->() = {
        (peek() == '=').then({
            advance();
            add(TokenKind.Define, ":=", startLine, startColumn);
            this ^=>;
        });
        add(TokenKind.Colon, ":", startLine, startColumn);
    }

    scanMinus(startLine co.int, startColumn co.int)->() = {
        (peek() == '>').then({
            advance();
            (peek() == '|').then({
                advance();
                add(TokenKind.BreakArrow, "->|", startLine, startColumn);
                this ^=>;
            });
            (peek() == '>').then({
                advance();
                add(TokenKind.ContinueArrow, "->>", startLine, startColumn);
                this ^=>;
            });
            add(TokenKind.Arrow, "->", startLine, startColumn);
            this ^=>;
        });
        add(TokenKind.Operator, "-", startLine, startColumn);
    }

    scanEquals(startLine co.int, startColumn co.int)->() = {
        (peek() == '>').then({
            advance();
            add(TokenKind.FatArrow, "=>", startLine, startColumn);
            this ^=>;
        });
        add(TokenKind.Assign, "=", startLine, startColumn);
    }

    scanCaret(startLine co.int, startColumn co.int)->() = {
        (peek() == '=').then({
            advance();
            (peek() == '>').then({
                advance();
                add(TokenKind.EnclosingReturnArrow, "^=>", startLine, startColumn);
                this ^=>;
            });
            add(TokenKind.Operator, "^=", startLine, startColumn);
            this ^=>;
        });
        add(TokenKind.Operator, "^", startLine, startColumn);
    }

    scanOperator(first co.char, startLine co.int, startColumn co.int)->() = {
        text := first.toString();
        (isOperatorCharacter(peek())).loop({ text = text + advance().toString(); });
        add(TokenKind.Operator, text, startLine, startColumn);
    }

    skipLineComment()->() = {
        (atEnd() == co.const.false && peek() != '\n').loop({ advance(); });
    }

    add(kind TokenKind, text co.string, line co.int, column co.int)->() = {
        tokens.add(Token{kind: kind, text: text, line: line, column: column});
    }

    advance()->(co.char) = {
        character := source[position];
        position = position + 1;
        column = column + 1;
        this => character;
    }

    peek()->(co.char) = {
        (atEnd()).then({ this ^=> '\0'; });
        this => source[position];
    }

    atEnd()->(co.bool) = { this => position >= source.length; }

    isWhitespace(character co.char)->(co.bool) = {
        this => character == ' ' || character == '\t' || character == '\r';
    }

    isDigit(character co.char)->(co.bool) = {
        this => character >= '0' && character <= '9';
    }

    isIdentifierStart(character co.char)->(co.bool) = {
        this => (character >= 'a' && character <= 'z') ||
                    (character >= 'A' && character <= 'Z') || character == '_';
    }

    isIdentifierPart(character co.char)->(co.bool) = {
        this => isIdentifierStart(character) || isDigit(character);
    }

    isQualifiedPrefix(text co.string)->(co.bool) = {
        this => text == "co" || text.startsWith("co.");
    }

    isBuiltInKind(text co.string)->(co.bool) = {
        this => text.match
            .case("co.struct" => co.const.true)
            .case("co.class" => co.const.true)
            .case("co.enum" => co.const.true)
            .case("co.unit" => co.const.true)
            .default(co.const.false);
    }

    isOperatorCharacter(character co.char)->(co.bool) = {
        this => character == '+' || character == '-' || character == '*' ||
                    character == '/' || character == '=' || character == '<' ||
                    character == '>' || character == '!' || character == '&' ||
                    character == '|';
    }
}
