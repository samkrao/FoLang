_ co.lang.class = {
    tokens TokenList;
    position co.lang.int;
    contexts ParseContextList;
    companionType co.lang.string;

    current()->(Token) = {
        this => tokens[position];
    }

    peek(distance co.lang.int)->(Token) = {
        index := position + distance;
        (index >= tokens.length).then({
            this => Token{kind: TokenKind.EndOfFile, text: "", line: 0, column: 0};
        });
        this => tokens[index];
    }

    advance()->(Token) = {
        token := current();
        (token.kind != TokenKind.EndOfFile).then({
            position = position + 1;
        });
        this => token;
    }

    at(kind TokenKind)->(co.lang.bool) = {
        this => current().kind == kind;
    }

    atText(text co.lang.string)->(co.lang.bool) = {
        this => current().text == text;
    }

    expect(kind TokenKind, purpose co.lang.string)->(Token) = {
        (at(kind)).then({
            this => advance();
        });

        co.out.println("parse error: expected " + purpose);
        this => advance();
    }

    pushContext(context ParseContext)->() = {
        contexts.add(context);
    }

    popContext()->() = {
        contexts.removeLast();
    }

    context()->(ParseContext) = {
        this => contexts[contexts.length - 1];
    }

    parseProject()->(SyntaxNode) = {
        declarations := SyntaxNodeList{};
        (at(TokenKind.EndOfFile) == co.const.false).loop({
            declarations.add(parseFileDeclaration());
        });
        this => SyntaxNode{kind: SyntaxKind.Project, text: "project", children: declarations};
    }

    parseFileDeclaration()->(SyntaxNode) = {
        skipAnnotations();
        expect(TokenKind.Identifier, "the filename-derived declaration name");
        declarationKind := expect(TokenKind.BuiltInKind, "a file declaration kind");

        this => declarationKind.text.match
            .case("co.lang.struct" => parseContainer(SyntaxKind.StructDeclaration, ParseContext.StructBody))
            .case("co.lang.class" => parseContainer(SyntaxKind.ClassDeclaration, ParseContext.ClassBody))
            .case("co.lang.enum" => parseEnum())
            .case("co.lang.unit" => parseUnit())
            .default(errorNode("unsupported file declaration " + declarationKind.text));
    }

    parseContainer(kind SyntaxKind, context ParseContext)->(SyntaxNode) = {
        expect(TokenKind.Assign, "= before a declaration body");
        expect(TokenKind.OpenBrace, "{ to open a declaration body");
        pushContext(context);
        members := SyntaxNodeList{};

        (at(TokenKind.CloseBrace) == co.const.false).loop({
            members.add(parseContainerMember());
        });

        expect(TokenKind.CloseBrace, "} to close a declaration body");
        popContext();
        this => SyntaxNode{kind: kind, text: "", children: members};
    }

    parseContainerMember()->(SyntaxNode) = {
        skipAnnotations();
        name := expect(TokenKind.Identifier, "a member name");

        // Context resolves the common case. Only `name (` needs one token of
        // lookahead to select a function; a field immediately carries its type.
        (at(TokenKind.OpenParen)).then({
            this => parseFunctionAfterName(name, co.const.false);
        });
        this => parseFieldAfterName(name);
    }

    parseUnit()->(SyntaxNode) = {
        expect(TokenKind.Assign, "= before a unit body");
        expect(TokenKind.OpenBrace, "{ to open a unit body");
        pushContext(ParseContext.UnitBody(companion=companionType != ""));
        members := SyntaxNodeList{};

        (at(TokenKind.CloseBrace) == co.const.false).loop({
            skipAnnotations();

            // In a companion unit, `(` at direct unit-member level can only
            // begin a receiver function. Calls and anonymous functions are not
            // legal unit members, so no speculative parse or rewind is needed.
            (companionType != "" && at(TokenKind.OpenParen)).then({
                members.add(parseReceiverFunction());
            }).default({
                name := expect(TokenKind.Identifier, "a unit member name");
                (at(TokenKind.OpenParen)).then({
                    members.add(parseFunctionAfterName(name, co.const.false));
                }).default({
                    members.add(parseTypeOrVariableAfterName(name));
                });
            });
        });

        expect(TokenKind.CloseBrace, "} to close a unit body");
        popContext();
        this => SyntaxNode{kind: SyntaxKind.UnitDeclaration, text: "", children: members};
    }

    parseReceiverFunction()->(SyntaxNode) = {
        
        expect(TokenKind.OpenParen, "( to open a receiver");
        
        receiver := expect(TokenKind.Identifier, "a receiver name or type");

        (at(TokenKind.Identifier)).then({ advance(); });
        
        expect(TokenKind.CloseParen, ") to close a receiver");
        
        name := expect(TokenKind.Identifier, "a receiver function name");
        
        function := parseFunctionAfterName(name, co.const.true);
        
        
        this => SyntaxNode{
            kind: SyntaxKind.ReceiverFunctionDeclaration,
            text: receiver.text + "." + function.text,
            children: function.children
        };
        
    }

    parseFunctionAfterName(name Token, receiver co.lang.bool)->(SyntaxNode) = {
        parameters := parseParameters();
        expect(TokenKind.Arrow, "-> before function results");
        results := parseResultTypes();
        expect(TokenKind.Assign, "= before a function body");
        body := parseBlock(ParseContext.FunctionBody);

        children := SyntaxNodeList{};
        children.add(parameters);
        children.add(results);
        children.add(body);
        this => SyntaxNode{kind: SyntaxKind.FunctionDeclaration, text: name.text, children: children};
    }

    parseParameters()->(SyntaxNode) = {
        expect(TokenKind.OpenParen, "( to open parameters");
        parameters := SyntaxNodeList{};
        (at(TokenKind.CloseParen) == co.const.false).loop({
            name := expect(TokenKind.Identifier, "a parameter name");
            typeName := expect(TokenKind.Identifier, "a parameter type");
            parameters.add(SyntaxNode{kind: SyntaxKind.FieldDeclaration, text: name.text + " " + typeName.text, children: SyntaxNodeList{}});
            (at(TokenKind.Comma)).then({ advance(); });
        });
        expect(TokenKind.CloseParen, ") to close parameters");
        this => SyntaxNode{kind: SyntaxKind.Block, text: "parameters", children: parameters};
    }

    parseResultTypes()->(SyntaxNode) = {
        expect(TokenKind.OpenParen, "( to open result types");
        results := SyntaxNodeList{};
        (at(TokenKind.CloseParen) == co.const.false).loop({
            resultType := expect(TokenKind.Identifier, "a result type");
            results.add(SyntaxNode{kind: SyntaxKind.NameExpression, text: resultType.text, children: SyntaxNodeList{}});
            (at(TokenKind.Comma)).then({ advance(); });
        });
        expect(TokenKind.CloseParen, ") to close result types");
        this => SyntaxNode{kind: SyntaxKind.Block, text: "results", children: results};
    }

    parseEnum()->(SyntaxNode) = {
        expect(TokenKind.Assign, "= before an enum body");
        expect(TokenKind.OpenBrace, "{ to open an enum body");
        pushContext(ParseContext.EnumBody);
        states := SyntaxNodeList{};

        (at(TokenKind.CloseBrace) == co.const.false).loop({
            skipAnnotations();
            stateName := expect(TokenKind.Identifier, "an enum state name");
            fields := SyntaxNodeList{};
            (at(TokenKind.OpenParen)).then({
                advance();
                (at(TokenKind.CloseParen) == co.const.false).loop({
                    fieldName := expect(TokenKind.Identifier, "an enum state parameter name");
                    fieldType := expect(TokenKind.Identifier, "an enum state parameter type");
                    fields.add(SyntaxNode{kind: SyntaxKind.FieldDeclaration, text: fieldName.text + " " + fieldType.text, children: SyntaxNodeList{}});
                    (at(TokenKind.Comma)).then({ advance(); });
                });
                expect(TokenKind.CloseParen, ") to close enum state parameters");
            });
            states.add(SyntaxNode{kind: SyntaxKind.EnumState, text: stateName.text, children: fields});
            (at(TokenKind.Comma)).then({ advance(); });
        });

        expect(TokenKind.CloseBrace, "} to close an enum body");
        popContext();
        this => SyntaxNode{kind: SyntaxKind.EnumDeclaration, text: "", children: states};
    }

    parseBlock(context ParseContext)->(SyntaxNode) = {
        expect(TokenKind.OpenBrace, "{ to open a function body");
        pushContext(context);
        statements := SyntaxNodeList{};
        (at(TokenKind.CloseBrace) == co.const.false).loop({
            statements.add(parseStatement());
        });
        expect(TokenKind.CloseBrace, "} to close a function body");
        popContext();
        this => SyntaxNode{kind: SyntaxKind.Block, text: "", children: statements};
    }

    parseStatement()->(SyntaxNode) = {
        (atText("this") && peek(1).kind == TokenKind.EnclosingReturnArrow).then({
            advance();
            advance();
            (context() != ParseContext.AnonymousArgumentBlock).then({
                co.out.println("parse error: this ^=> is allowed only in an anonymous call-argument block");
            });
            values := SyntaxNodeList{};
            (at(TokenKind.Semicolon) == co.const.false).then({
                values.add(parseExpression(0));
                (at(TokenKind.Comma)).loop({
                    advance();
                    values.add(parseExpression(0));
                });
            });
            expect(TokenKind.Semicolon, "; after this ^=> result values");
            this => SyntaxNode{kind: SyntaxKind.ReturnStatement, text: "enclosing-callable", children: values};
        });

        (atText("this") && peek(1).kind == TokenKind.FatArrow).then({
            advance();
            advance();
            (context() == ParseContext.AnonymousArgumentBlock).then({
                co.out.println("parse error: this => cannot cross an anonymous call-argument block; use this ^=>");
            });
            values := SyntaxNodeList{};
            (at(TokenKind.Semicolon) == co.const.false).then({
                values.add(parseExpression(0));
                (at(TokenKind.Comma)).loop({
                    advance();
                    values.add(parseExpression(0));
                });
            });
            expect(TokenKind.Semicolon, "; after this => result values");
            this => SyntaxNode{kind: SyntaxKind.ReturnStatement, text: "", children: values};
        });

        (atText("this") && peek(1).kind == TokenKind.BreakArrow).then({
            advance();
            advance();
            label := SyntaxNodeList{};
            (at(TokenKind.Operator) && current().text == "'").then({
                advance();
                label.add(parseName());
            });
            expect(TokenKind.Semicolon, "; after this ->| break");
            this => SyntaxNode{kind: SyntaxKind.BreakStatement, text: "", children: label};
        });

        (atText("this") && peek(1).kind == TokenKind.ContinueArrow).then({
            advance();
            advance();
            label := SyntaxNodeList{};
            (at(TokenKind.Operator) && current().text == "'").then({
                advance();
                label.add(parseName());
            });
            expect(TokenKind.Semicolon, "; after this ->> continue");
            this => SyntaxNode{kind: SyntaxKind.ContinueStatement, text: "", children: label};
        });

        // At statement level `name :=` or `name Type` is a declaration. Once
        // `=` or `:=` is consumed, expression parsing owns the right-hand side.
        (at(TokenKind.Identifier) && (peek(1).kind == TokenKind.Define || peek(1).kind == TokenKind.Identifier)).then({
            this => parseVariableDeclaration();
        });

        expression := parseExpression(0);
        expect(TokenKind.Semicolon, "; after an expression statement");
        this => expression;
    }

    parseVariableDeclaration()->(SyntaxNode) = {
        name := advance();
        (at(TokenKind.Identifier)).then({ advance(); });
        (at(TokenKind.Define) || at(TokenKind.Assign)).then({ advance(); });
        value := parseExpression(0);
        expect(TokenKind.Semicolon, "; after a variable declaration");
        this => SyntaxNode{kind: SyntaxKind.VariableDeclaration, text: name.text, children: SyntaxNodeList{value}};
    }

    parseExpression(minimumBindingPower co.lang.int)->(SyntaxNode) = {
        left := parsePrimary();

        (isExpressionContinuation(minimumBindingPower)).loop({
            (at(TokenKind.OpenBrace)).then({
                left = parseCompositeConstruction(left);
            }).default({
                (at(TokenKind.OpenParen)).then({
                    left = parseCall(left);
                }).default({
                    (at(TokenKind.Dot)).then({
                        left = parseMember(left);
                    }).default({
                        operator := advance();
                        right := parseExpression(rightBindingPower(operator));
                        left = SyntaxNode{kind: SyntaxKind.BinaryExpression, text: operator.text, children: SyntaxNodeList{left, right}};
                    });
                });
            });
        });
        this => left;
    }

    parsePrimary()->(SyntaxNode) = {
        // `->` is a relationship selector only after the hard-reserved `this`
        // receiver. `->>` and `->|` are already distinct atomic tokens.
        (atText("this") && peek(1).kind == TokenKind.Arrow).then({
            this => parseRelationshipSelector();
        });

        token := advance();
        this => token.kind.match
            .case(TokenKind.Identifier => SyntaxNode{kind: SyntaxKind.NameExpression, text: token.text, children: SyntaxNodeList{}})
            .case(TokenKind.Integer => SyntaxNode{kind: SyntaxKind.LiteralExpression, text: token.text, children: SyntaxNodeList{}})
            .case(TokenKind.String => SyntaxNode{kind: SyntaxKind.LiteralExpression, text: token.text, children: SyntaxNodeList{}})
            .case(TokenKind.OpenParen => parseGroupedExpression())
            .default(errorNode("expected an expression"));
    }

    parseCall(target SyntaxNode)->(SyntaxNode) = {
        advance();
        arguments := SyntaxNodeList{};
        (at(TokenKind.CloseParen) == co.const.false).loop({
            // Enum-state calls are checked after the target resolves. The
            // syntactic `name=value` form is retained here so resolution can
            // require it for parameterized enum states.
            (at(TokenKind.OpenBrace)).then({
                arguments.add(parseBlock(ParseContext.AnonymousArgumentBlock));
            }).default({
                (at(TokenKind.Identifier) && peek(1).kind == TokenKind.Assign).then({
                    argumentName := advance();
                    advance();
                    argumentValue := parseExpression(0);
                    arguments.add(SyntaxNode{
                        kind: SyntaxKind.BinaryExpression,
                        text: "=",
                        children: SyntaxNodeList{
                            SyntaxNode{kind: SyntaxKind.NameExpression, text: argumentName.text, children: SyntaxNodeList{}},
                            argumentValue
                        }
                    });
                }).default({
                    arguments.add(parseExpression(0));
                });
            });
            (at(TokenKind.Comma)).then({ advance(); });
        });
        expect(TokenKind.CloseParen, ") to close arguments");
        arguments.add(target);
        this => SyntaxNode{kind: SyntaxKind.CallExpression, text: "", children: arguments};
    }

    parseCompositeConstruction(target SyntaxNode)->(SyntaxNode) = {
        expect(TokenKind.OpenBrace, "{ to open a composite construction");
        entries := SyntaxNodeList{};
        entries.add(target);
        (at(TokenKind.CloseBrace) == co.const.false).loop({
            first := parseExpression(0);
            (at(TokenKind.Assign)).then({
                co.out.println("parse error: typed composite entries use :; = is metadata syntax");
                advance();
                second := parseExpression(0);
                first = SyntaxNode{kind: SyntaxKind.BinaryExpression, text: ":", children: SyntaxNodeList{first, second}};
            });
            (at(TokenKind.Colon)).then({
                advance();
                second := parseExpression(0);
                first = SyntaxNode{kind: SyntaxKind.BinaryExpression, text: ":", children: SyntaxNodeList{first, second}};
            });
            entries.add(first);
            (at(TokenKind.Comma)).then({ advance(); });
        });
        expect(TokenKind.CloseBrace, "} to close a composite construction");
        this => SyntaxNode{kind: SyntaxKind.CompositeConstruction, text: target.text, children: entries};
    }

    parseMember(target SyntaxNode)->(SyntaxNode) = {
        advance();
        member := expect(TokenKind.Identifier, "a member name");
        this => SyntaxNode{kind: SyntaxKind.MemberExpression, text: member.text, children: SyntaxNodeList{target}};
    }

    parseName()->(SyntaxNode) = {
        first := expect(TokenKind.Identifier, "a name");
        text := first.text;
        (at(TokenKind.Dot)).loop({
            advance();
            segment := expect(TokenKind.Identifier, "a qualified-name segment");
            text = text + "." + segment.text;
        });
        this => SyntaxNode{kind: SyntaxKind.NameExpression, text: text, children: SyntaxNodeList{}};
    }

    parseRelationshipSelector()->(SyntaxNode) = {
        advance();
        expect(TokenKind.Arrow, "-> after this in a relationship selector");
        relationship := expect(TokenKind.Identifier, "a language-defined relationship name");

        valid := relationship.text == "parent" || relationship.text == "super" ||
                 relationship.text == "parents" || relationship.text == "classes" ||
                 relationship.text == "mixins" || relationship.text == "traits" ||
                 relationship.text == "interfaces";
        (valid == co.const.false).then({
            this => errorNode("unknown this-> relationship " + relationship.text);
        });

        children := SyntaxNodeList{};
        keyed := relationship.text == "parents" || relationship.text == "classes" ||
                 relationship.text == "mixins" || relationship.text == "traits" ||
                 relationship.text == "interfaces";
        (keyed).then({
            expect(TokenKind.OpenBracket, "[ after a keyed relationship selector");
            children.add(parseName());
            expect(TokenKind.CloseBracket, "] after a relationship type name");
        }).default({
            (at(TokenKind.OpenBracket)).then({
                co.out.println("parse error: this->parent and this->super are not keyed");
            });
        });

        this => SyntaxNode{kind: SyntaxKind.RelationshipExpression, text: relationship.text, children: children};
    }

    parseGroupedExpression()->(SyntaxNode) = {
        value := parseExpression(0);
        expect(TokenKind.CloseParen, ") to close a grouped expression");
        this => value;
    }

    isExpressionContinuation(minimumBindingPower co.lang.int)->(co.lang.bool) = {
        (at(TokenKind.OpenParen) || at(TokenKind.OpenBrace) || at(TokenKind.Dot)).then({ this => co.const.true; });
        (at(TokenKind.Operator)).then({
            this => leftBindingPower(current()) >= minimumBindingPower;
        });
        this => co.const.false;
    }

    leftBindingPower(operator Token)->(co.lang.int) = {
        this => operator.text.match
            .case("*" => 70)
            .case("/" => 70)
            .case("+" => 60)
            .case("-" => 60)
            .case("==" => 40)
            .default(0);
    }

    rightBindingPower(operator Token)->(co.lang.int) = {
        this => leftBindingPower(operator) + 1;
    }

    parseFieldAfterName(name Token)->(SyntaxNode) = {
        typeName := expect(TokenKind.Identifier, "a field type");
        expect(TokenKind.Semicolon, "; after a field");
        this => SyntaxNode{kind: SyntaxKind.FieldDeclaration, text: name.text + " " + typeName.text, children: SyntaxNodeList{}};
    }

    parseTypeOrVariableAfterName(name Token)->(SyntaxNode) = {
        declaredType := advance();
        (at(TokenKind.Assign)).then({
            advance();
            value := parseExpression(0);
            expect(TokenKind.Semicolon, "; after a declaration");
            this => SyntaxNode{kind: SyntaxKind.VariableDeclaration, text: name.text + " " + declaredType.text, children: SyntaxNodeList{value}};
        });
        expect(TokenKind.Semicolon, "; after a declaration");
        this => SyntaxNode{kind: SyntaxKind.VariableDeclaration, text: name.text + " " + declaredType.text, children: SyntaxNodeList{}};
    }

    skipAnnotations()->() = {
        (at(TokenKind.Annotation)).loop({
            advance();
            (at(TokenKind.OpenParen)).then({ skipBalancedParentheses(); });
        });
    }

    skipBalancedParentheses()->() = {
        depth := 0;
        (at(TokenKind.EndOfFile) == co.const.false).loop({
            token := advance();
            (token.kind == TokenKind.Colon).then({
                co.out.println("parse error: metadata fields use =; : is typed-composite syntax");
            });
            (token.kind == TokenKind.OpenParen).then({ depth = depth + 1; });
            (token.kind == TokenKind.CloseParen).then({
                depth = depth - 1;
                (depth == 0).then({ this =>; });
            });
        });
        co.out.println("parse error: unterminated annotation arguments");
    }

    errorNode(message co.lang.string)->(SyntaxNode) = {
        co.out.println("parse error: " + message);
        this => SyntaxNode{kind: SyntaxKind.ErrorNode, text: message, children: SyntaxNodeList{}};
    }

    printNode(node SyntaxNode)->() = {
        // Dummy output in place of filesystem serialization.
        co.out.println(node.kind + ": " + node.text);
        node.children.each(_, child, {
            printNode(child);
        });
    }
}
