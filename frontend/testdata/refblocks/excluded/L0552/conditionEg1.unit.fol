(boolean truth).do({
}).otherwise(boolean truth).do({
}).otherwise.do({
});

//conditionEg1.unit.fol

_ co.lang.unit = {

    someFun()->()={

        x := co.const.true;

        x.do({

        }).otherwise.do({

        });
    }

    someOtherFun()->()={

        (co.const.true).do({  //parenthesis mandatory

        }).otherwise.do({

        });
    }

    someOtherFun1()->()={
        x co.lang.bool =co.const.true;
        (x).do({   //parenthisis optional

        }).otherwise.do({

        });

    }

    someOtherDiffFun1()->()={

        x co.lang.int=10;
        y:=30;

        (x > y).do({     //paretheisis around (x > y) is mandatory

        }).otherwise(x < y).do({

        }).otherwise.do({

        });
    }
}
