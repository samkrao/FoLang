(boolean truth).loop({
}).otherwise(boolean truth).loop({
}).otherwise.loop({
});


//loopsEg1.unit.fol

_ co.lang.unit = {

    someFun()->()={

        x := co.const.true;

        x.loop({

        }).otherwise.loop({

        });
    }

    someOtherFun()->()={

        (co.const.true).loop({  //parenthesis mandatory

        }).otherwise.loop({

        });
    }

    someOtherFun1()->()={
        x co.lang.bool =co.const.true;
        (x).loop({   //parenthisis optional

        }).otherwise.loop({

        });

    }

    someOtherDiffFun1()->()={

        x co.lang.int=10;
        y:=30;

        (x > y).loop({     //paretheisis around (x > y) is mandatory

        }).otherwise(x < y).loop({

        }).otherwise.loop({

        });
    }
}
