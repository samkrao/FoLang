@co.dap.library(type=operator)
_ co.lang.library = {
    <+> co.lang.operator = {
        fixity=infix,
        precedence=60,
        associativity=left,
        arity=binary,
        commutative=co.const.false,
        idempotent=co.const.false,
        identity=co.const.none,
        foldable=co.const.true,
        vectorizable=co.const.false,
        distributes_over=['*', "+-"],
        desugar="intrinsic:combine",
    }

    !! co.lang.operator = {
        fixity=prefix,
        precedence=0,
        associativity=right,
        arity=1
    }
}
