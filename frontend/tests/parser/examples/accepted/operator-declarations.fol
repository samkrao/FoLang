Vector co.lang.unit = {
    @co.dap.operator(symbol='+', mode=overload)
    add(left Vector, right Vector)->(Vector) = {
        this.return left;
    }

    @co.dap.operator(
        symbol="<+>",
        mode=define,
        fixity=infix,
        precedence=65,
        associativity=left,
        arity=binary
    )
    combine(left Vector, right Vector)->(Vector) = {
        this.return left;
    }
}
