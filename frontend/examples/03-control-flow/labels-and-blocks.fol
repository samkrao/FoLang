// labels-and-blocks.fol — application entry file
// Spec: language-ref.md > Labels and Named Blocks
// Grammar: labeled-block, block-statement
//
// A block statement and a labeled block are bodies: they end at `}` and take
// no trailing semicolon.

total co.lang.int = 0;

// --- bare block: an ordinary nested scope --------------------------------
{
    scoped co.lang.int = 10;
    total += scoped;
}

// --- labeled block ------------------------------------------------------
outer: {
    total += 1;

    inner: {
        total += 2;
    }
}

// A block used as an expression still needs the enclosing statement's `;`,
// because the value-producing reading is an expression, not a body. The final
// expression of a block, written without a semicolon, is its value.
computed := {
    a co.lang.int = 2;
    b co.lang.int = 3;
    a * b
};

co.out.println(total);
co.out.println(computed);

// A reusable named block is a primary declaration and therefore lives in its
// own package source file — see blocks/Retry.fol, expanded with:
//     Retry.expand();
