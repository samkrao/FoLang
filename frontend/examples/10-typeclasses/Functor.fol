// Functor.fol — package source file
// Spec: language-ref.md > Type Classes > Functor
// Grammar: annotated-contract-declaration
//
// `F` is a higher-kinded parameter: it stands for a type CONSTRUCTOR such as
// List or Option, not for a concrete type.

@co.dap.typeclass(kind=Functor)
_(F) = {
    map(value F(A), f (A)->B)->(F(B));
}
