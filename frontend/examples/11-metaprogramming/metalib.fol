// metalib.fol — library surface file
// Spec: language-ref.md > Libraries, Library Kinds > `advanced` Libraries
//
// An advanced library may use macros, templates, and execution machinery
// internally, but its PUBLIC surface is the same shape as every other library:
// boundary data contracts plus public boundary-adapter functions.
//
// For application-family kinds (application, dynamicvmrt, advanced) the
// boundary data is co.lang.struct, transferred by automatic deep snapshot.

@co.dap.library(type="advanced")
metalib co.lang.library = {

    @co.ddap.import(package="execution", as="exec")
    @co.ddap.import(package="templates", as="tpl")

    // boundary contract
    Job co.lang.struct = {
        id     co.lang.int;
        label  co.lang.string;
        result co.lang.int;
    }

    // converting adapter: read parameters, build the internal input, invoke
    // exactly one internal operation, convert the result back
    runJob(id co.lang.int, label co.lang.string)->(Job) = {
        computed := exec.Tasks.run(id);

        this.return Job{
            id: id,
            label: label,
            result: computed
        };
    }

    // direct delegation when no conversion is needed
    addNumbers(a co.lang.int, b co.lang.int)->(co.lang.int)
        => tpl.Arithmetic.add(a, b);
}

// A boundary adapter may NOT implement business rules, orchestrate several
// internal operations, call another surface function, perform I/O, start
// concurrency, loop, recurse, or leak an internal value without converting it.
// The restriction is structural: placing logic in a surface file does not make
// it acceptable.
